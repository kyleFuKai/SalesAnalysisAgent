# ============================================================
# kyle-sales-agent 环境变量模板
# 复制为 .env 并填入实际值；.env 已加入 .gitignore 不会被提交
# ============================================================

# ========== MySQL 数据库（必填）==========
DB_HOST=
DB_PORT=3306
DB_NAME=sales_agent
DB_USERNAME=root
DB_PASSWORD=

# ========== Redis（必填）==========
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== AI 模型 / LangChain4j（必填）==========
# 通义千问 DashScope API Key
# 申请地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# ========== Sa-Token 鉴权（必填）==========
# 32 位以上随机字符串，用于 token 签名
# 生成方法：openssl rand -hex 32
SA_TOKEN_SECRET=

# ========== 首次创建系统管理员（可选，仅第一次启动时临时设置）==========
# 先完成 db/migration-20261002-account-admin.sql；密码至少 12 位且最多 72 字节。
# 成功创建后从运行环境及本地 .env 中移除此变量；不要填写在 .env.example 或提交到 Git。
# APP_BOOTSTRAP_ADMIN_PASSWORD=
