# ============================================================
# kyle-sales-agent 环境变量模板
# 复制为 .env 并填入实际值；.env 已加入 .gitignore 不会被提交
# ============================================================

# ========== MySQL 数据库（必填）==========
DB_HOST=
DB_PORT=3306
DB_NAME=sales_agent
DB_USERNAME=root
DB_PASSWORD=

# ========== Redis（必填）==========
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== AI 模型 / LangChain4j（必填）==========
# 通义千问 DashScope API Key
# 申请地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# ========== Sa-Token 鉴权（必填）==========
# 32 位以上随机字符串，用于 token 签名
# 生成方法：openssl rand -hex 32
SA_TOKEN_SECRET=
